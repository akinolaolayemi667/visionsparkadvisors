# Server-side (set these in Vercel → Project → Settings → Environment Variables)
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO=joelfacco.positioning@gmail.com

# Optional. After you verify a domain in Resend, use e.g.
# VisionSpark Advisors <enquiries@yourdomain.com>
# Until then Resend’s onboarding address works for testing.
RESEND_FROM=VisionSpark Advisors <onboarding@resend.dev>

# Public site origin (custom domain). Used at build time for canonical/OG/sitemap,
# and optionally by the API. No trailing slash.
VITE_SITE_URL=https://visionsparkadvisors.vercel.app
SITE_URL=https://visionsparkadvisors.vercel.app

# Optional — Stripe Checkout after written agreement only (see SETUP-PAYMENTS.md)
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_PRICE_FOUNDATION=price_xxxxxxxx
STRIPE_PRICE_EXECUTIVE=price_xxxxxxxx
STRIPE_PRICE_PARTNERSHIP=price_xxxxxxxx
